{
  "name": "markdown",
  "version": "1.0.0",
  "suite": "jolaapps",
  "type": "fullstack",
  "runtime": "node",
  "driver": "native",
  "repo": "",
  "ports": {
    "dev": 3116,
    "uat": 3116,
    "prod": 3116
  },
  "domains": {
    "uat": "markdown.mpondoland.com",
    "prod": "markdown.pltfm.ai"
  },
  "lifecycle": {
    "run": {
      "dev": "./run.sh dev",
      "uat": "./run.sh uat",
      "prod": "./run.sh prod"
    },
    "restart": {
      "dev": "./run.sh restart",
      "uat": "./run.sh restart",
      "prod": "./run.sh restart"
    },
    "update": {
      "command": "git pull origin main",
      "auto_stash": true
    },
    "startup_checks": {
      "command": "",
      "timeout_seconds": 15
    },
    "install": {
      "command": "./install.sh",
      "timeout_seconds": 600,
      "binary": "markdown"
    }
  },
  "health_check": {
    "path": "/",
    "interval_seconds": 5,
    "timeout_seconds": 3,
    "max_retries": 5
  },
  "env_vars": {
    "required": [
      "PORT"
    ],
    "defaults": {
      "PORT": "3116"
    }
  }
}
