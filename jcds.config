{
  "name": "markdown",
  "version": "1.0.0",
  "suite": "jolaapps",
  "type": "asset",
  "runtime": "static",
  "driver": "docker",
  "repo": "git@github.com:chmjdev/markdown.git",
  "ports": {
    "dev": 3116,
    "uat": 3116,
    "prod": 3116
  },
  "domains": {
    "uat": "",
    "prod": "markdown.pltfm.ai"
  },
  "lifecycle": {
    "run": {
      "dev": "./start.sh dev",
      "prod": "./start.sh prod"
    },
    "restart": {
      "dev": "./start.sh dev",
      "prod": "./start.sh restart"
    },
    "update": {
      "command": "git pull --ff-only origin main",
      "auto_stash": false
    },
    "startup_checks": {
      "command": "python3 scripts/check_guide.py",
      "timeout_seconds": 15
    }
  },
  "health_check": {
    "path": "/healthz",
    "interval_seconds": 5,
    "timeout_seconds": 3,
    "max_retries": 5,
    "static_only": true
  },
  "env_vars": {
    "required": [],
    "defaults": {}
  },
  "dev_driver": "native",
  "supported_stages": [
    "dev",
    "prod"
  ],
  "stages": [
    "dev",
    "prod"
  ],
  "released": false,
  "static_only": true,
  "description": "Local macOS Markdown editor; public static user guide",
  "datastore": {
    "engine": "none",
    "stages": {
      "dev": {
        "provider": "none"
      },
      "uat": {
        "provider": "none"
      },
      "prod": {
        "provider": "none"
      }
    }
  }
}
